# EMAIL & CONTACT CONFIGURATION
# ============================

# APP
# Use a long random value in production.
SECRET_KEY=change-me-to-a-long-random-secret
ENVIRONMENT=production
SITE_URL=https://your-domain.com

# DATABASE
# Local development can omit this and use SQLite.
# Aiven MySQL example:
# DATABASE_URL=mysql+pymysql://avnadmin:YOUR_PASSWORD@YOUR_HOST.aivencloud.com:YOUR_PORT/defaultdb?ssl=true
DATABASE_URL=

# YOUR EMAIL (Gmail recommended)
SENDER_EMAIL=ajayprakashp59@gmail.com

# YOUR GMAIL APP PASSWORD (Not your regular Gmail password!)
# How to get App Password:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Select "Mail" and "Windows Computer"
# 3. Copy the 16-character password
# 4. Paste it below (it will look like: xxxx xxxx xxxx xxxx)
SENDER_PASSWORD=your_16_character_app_password_here

# ADMIN EMAIL (Where contact forms will be sent)
ADMIN_EMAIL=ajayprakashp59@gmail.com

# YOUR WHATSAPP PHONE NUMBER (International format)
ADMIN_PHONE=+918881254553

# WHATSAPP MESSAGE PREFIX (Optional)
WHATSAPP_MESSAGE_PREFIX=Hello! I got your message and will reply soon.
