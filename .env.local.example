# Copy this file to .env.local and fill values for local testing (DO NOT COMMIT secrets)

# Database (MySQL/TiDB)
# Example: mysql+pymysql://webuser:StrongPass!@your-tidb-host:4000/portfolio_db?charset=utf8mb4
DATABASE_URL=

# If your TiDB requires TLS, paste the base64 of the CA file here
# TIDB_CA_BASE64=

SECRET_KEY=
ADMIN_EMAIL=
# Optional: seed admin non-interactively
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
